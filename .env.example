# RC CONSULTANCY - Environment Variables Configuration

# Base URL (for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://rcconsultancy.co.in

# Optional SMTP Server for contact form submissions (Nodemailer)
# If omitted, contact submissions are safely logged on server and client has mailto/WhatsApp fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=
